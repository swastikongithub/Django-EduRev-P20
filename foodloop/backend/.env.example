# Copy this file to .env (same folder) and adjust. Never commit the real .env.

# development | test | production
APP_ENV=development

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://foodloop:foodloop@localhost:5432/foodloop
# Used only by the automated tests (pytest wipes this database between tests)
TEST_DATABASE_URL=postgresql://foodloop:foodloop@localhost:5432/foodloop_test

# Websites allowed to send POST/PATCH/DELETE requests (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when the site is served over HTTPS (always in production)
COOKIE_SECURE=false

# Food-safety policy: the longest time from "prepared at" to "eat by" for each storage type.
# These are conservative pilot defaults, NOT legal limits. Agree real values with the kitchen's
# Food Safety Supervisor.
MAX_SAFE_HOURS_ROOM_TEMP=2
MAX_SAFE_HOURS_HOT_HELD=4
MAX_SAFE_HOURS_REFRIGERATED=24
MAX_SAFE_HOURS_SHELF_STABLE=48

# Reservations close this many minutes before the pickup window ends
RESERVATION_CUTOFF_MINUTES=10

# Development only: keep the sample kitchens' meals listed so your local site always has food on it
# (after you've run `python -m app.cli seed-sample` once). Ignored in production.
SAMPLE_AUTO_REFRESH=true
